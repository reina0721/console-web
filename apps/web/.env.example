# Host server configuration (managed by @community-go/config)
# Defaults to 0.0.0.0 (open to local network / container environments).
# Set to 127.0.0.1 if you wish to restrict server listening to localhost only:
# WEB_HOST=0.0.0.0
# WEB_PORT=4173

# Public values are bundled at build time; never put server secrets here.
# Explicit demo deployment:
WEB_DEPLOYMENT_MODE=static
# Authentication and product user/role/notification/audit data use the same mode.
NEXT_PUBLIC_AUTH_MODE=mock

# Backend deployment (replace the mode above):
# NEXT_PUBLIC_AUTH_MODE=backend
# NEXT_PUBLIC_AUTH_API_BASE_URL=/api
# The authentication API is a proposed cookie/CSRF contract, pending real integration.
